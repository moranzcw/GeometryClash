# 统一换行符，避免 Windows / macOS 互相提交整文件 diff
* text=auto eol=lf

# ---- Unity 的 YAML 资源：按文本处理，diff 才可读 ----
*.unity       text
*.prefab      text
*.asset       text
*.mat         text
*.meta        text
*.controller  text
*.anim        text
*.overrideController text

# ---- 代码与配置 ----
*.cs       text diff=csharp
*.shader   text
*.hlsl     text
*.cginc    text
*.json     text
*.md       text
*.asmdef   text

# ---- 二进制资源（本工程目前没有，留着备用）----
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.tga  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.fbx  binary
*.ttf  binary
*.otf  binary
